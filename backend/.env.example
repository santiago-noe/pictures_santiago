# PostgreSQL. En local: tu Postgres local. En producción: connection string de Neon (neon.tech),
# incluye ?sslmode=require al final.
DATABASE_URL="postgresql://user:password@localhost:5432/fotos?schema=public"

# Genera una cadena aleatoria larga, por ejemplo con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Cloudinary (dashboard.cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL del frontend desplegado (para CORS). En local: http://localhost:3000
FRONTEND_URL="http://localhost:3000"

NODE_ENV="development"
PORT=4000
